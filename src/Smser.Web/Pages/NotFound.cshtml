@page "/not-found"
@model NotFoundModel
@{
    ViewData["Title"] = "Not found — SMSer";
}

<div class="message-page">
    <h1>No list here.</h1>
    <p>
        That link does not match a saved list. It may have been mistyped, or the list may
        never have been generated.
    </p>
    <p><a class="button" href="/new">Start a new list</a></p>
</div>
