@page "{id?}"
@model NewModel
@{
    ViewData["Title"] = Model.HasResult ? $"{Model.Input.GroupName} — SMSer" : "New SMS group — SMSer";
}

<div class="split">
    <section class="panel">
        <h1>@(Model.HasResult ? "Edit SMS group" : "New SMS group")</h1>

        @*
            The action is set explicitly, and it has to be. A bare <form method="post">
            has no action attribute, so the browser posts to the *current document URL* —
            which after the Import button has run is /new?handler=Import. Generate carries
            no formaction of its own, so it would inherit that URL and re-run the import
            handler instead of saving: the roster never persists and no QR code appears.
        *@
        <form method="post" asp-page="/New" asp-route-id="@Model.Id">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="field">
                <label asp-for="Input.GroupName">SMS group name</label>
                <input asp-for="Input.GroupName" placeholder="soccer team 2023" autocomplete="off" />
                <p class="hint">This helps you tell multiple teams and rosters apart.</p>
                <span asp-validation-for="Input.GroupName" class="validation-message"></span>
            </div>

            @*
                Photo import. Starts hidden and is revealed by photo-ocr.js, because none
                of it works without JavaScript — showing a camera button that cannot do
                anything is worse than not offering one. Everything below still works.
            *@
            <div class="field" data-photo hidden>
                <span class="field-label" id="photo-label">Photo of the roster</span>

                <div class="photo" data-photo-zone role="group" aria-labelledby="photo-label">
                    <div class="photo-idle" data-photo-idle>
                        <span class="photo-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14.5 4h-5L8 6H4.5A1.5 1.5 0 0 0 3 7.5v11A1.5 1.5 0 0 0 4.5 20h15a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 19.5 6H16z" />
                                <circle cx="12" cy="13" r="3.5" />
                            </svg>
                        </span>

                        @* The paste hint starts hidden for the same reason the whole
                           control does: photo-ocr.js reveals it only once the paste
                           listener is actually wired up, so it never promises a shortcut
                           that does nothing. It rides inside .on-fine because pasting is a
                           keyboard move — there is nothing to press on a phone. *@
                        <p class="photo-title">
                            <span class="on-fine">
                                Drop a photo of the roster here<span data-photo-paste-hint hidden>, or paste one</span>
                            </span>
                            <span class="on-coarse">Snap the roster and it reads itself</span>
                        </p>
                        <p class="photo-or">or</p>

                        <div class="photo-actions">
                            <button type="button" class="button button-secondary photo-camera" data-photo-take>
                                Take a photo
                            </button>
                            <button type="button" class="button button-secondary" data-photo-choose>
                                Choose a photo
                            </button>
                        </div>

                        <p class="photo-note">
                            Read on your device — the photo is never uploaded anywhere.
                        </p>
                    </div>

                    <div class="photo-busy" data-photo-busy hidden>
                        <img class="photo-preview" data-photo-preview alt="" />
                        <div class="photo-progress">
                            <div class="photo-bar"><span data-photo-bar></span></div>
                            <p class="photo-status" data-photo-status role="status" aria-live="polite"></p>
                            <button type="button" class="photo-reset" data-photo-reset hidden>Use a different photo</button>
                        </div>
                    </div>
                </div>

                @* Two inputs, not one. `capture` asks a phone for the camera directly, which
                   is the point on mobile but takes the photo library away — so the plain
                   input stays for choosing an existing shot. *@
                <input type="file" accept="image/*" hidden data-photo-file aria-hidden="true" tabindex="-1" />
                <input type="file" accept="image/*" capture="environment" hidden data-photo-capture aria-hidden="true" tabindex="-1" />
            </div>

            <div class="field">
                <label asp-for="Input.RawText">Roster import</label>
                <textarea asp-for="Input.RawText" rows="6"
                          placeholder="Paste anything here — names, numbers, whatever your phone copied."></textarea>
                <p class="hint">
                    Paste whatever your phone will &quot;copy as text&quot;. Import pulls the phone
                    numbers out of the garbled result, in whatever format they are written.
                </p>
                <span asp-validation-for="Input.RawText" class="validation-message"></span>
            </div>

            <div class="actions">
                @* Route values named explicitly rather than left to the ambient ones, so
                   the formaction stays correct on /new/{id} as well as on /new. *@
                <button type="submit" asp-page="/New" asp-page-handler="Import" asp-route-id="@Model.Id"
                        data-photo-import class="button button-secondary">Import</button>
            </div>

            @if (Model.ImportMessage is not null)
            {
                <p class="notice">@Model.ImportMessage</p>
            }

            <div class="field">
                <label asp-for="Input.Numbers">Phone numbers</label>
                <textarea asp-for="Input.Numbers" rows="10" placeholder="(219) 555-0113"></textarea>
                <p class="hint">
                    One per line. Edit freely — anything you type is re-checked when you generate.
                    <br />
                    <strong>Important:</strong> remove your own number if it is in the list.
                </p>
                <span asp-validation-for="Input.Numbers" class="validation-message"></span>
            </div>

            <div class="actions">
                <button type="submit" class="button">@(Model.HasResult ? "Regenerate" : "Generate")</button>
            </div>
        </form>
    </section>

    <section class="panel">
        @if (Model.HasResult)
        {
            <h1>Your QR code</h1>

            @if (Model.QrDataUri is not null)
            {
                <img class="qr" src="@Model.QrDataUri" alt="QR code that opens a group message to this roster"
                     width="640" height="640" />
            }
            else if (Model.QrTooLarge)
            {
                <p class="notice">
                    This list is too long to fit in a QR code — @Model.Numbers.Count numbers.
                    The mobile link below still works.
                </p>
            }

            <div class="actions actions-center">
                <a class="button" href="@Model.SmsUrl">Mobile link</a>
                <button type="button" class="button button-secondary" data-copy="@Model.ShareUrl">Copy share link</button>
            </div>

            <p class="hint hint-center" data-copy-status role="status">
                On a phone, the mobile link opens a message with all @Model.Numbers.Count numbers in it.
                Copy the share link to send this list to another device, or to keep it for later.
            </p>

            <details class="roster">
                <summary>@Model.Numbers.Count number@(Model.Numbers.Count == 1 ? "" : "s") in this list</summary>
                <ol>
                    @foreach (var number in Model.Numbers)
                    {
                        <li>@PhoneNumberParser.Format(number)</li>
                    }
                </ol>
            </details>
        }
        else
        {
            <div class="placeholder">
                <p>Your QR code shows up here once you generate the list.</p>
            </div>
        }
    </section>
</div>

@section Scripts {
    @* Only on this page. The home page has no photo control and should not pay for the
       script that drives one; the OCR engine itself is fetched later still, on first use. *@
    <script src="~/js/photo-ocr.js" asp-append-version="true"></script>
}
