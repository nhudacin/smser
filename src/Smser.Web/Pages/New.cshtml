@page "{id?}"
@model NewModel
@{
    @* The name is optional, so a saved list may not have one to put in the tab. *@
    ViewData["Title"] = Model.HasResult && !string.IsNullOrWhiteSpace(Model.Input.GroupName)
        ? $"{Model.Input.GroupName} — SMSer"
        : Model.HasResult ? "Your list — SMSer" : "New SMS group — SMSer";
}

<div class="split">
    <section class="panel">
        <h1>@(Model.HasResult ? "Edit SMS group" : "New SMS group")</h1>

        @*
            The action is set explicitly, and it has to be. A bare <form method="post">
            has no action attribute, so the browser posts to the *current document URL* —
            which after the Import button has run is /new?handler=Import. Generate carries
            no formaction of its own, so it would inherit that URL and re-run the import
            handler instead of saving: the roster never persists and no QR code appears.
        *@
        <form method="post" asp-page="/New" asp-route-id="@Model.Id">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            @*
                Bot checks. See FormGuard for what these are and what they are not.

                The honeypot is a real text input rather than type="hidden", because the
                bots worth catching skip hidden inputs and fill everything else. It is
                moved off screen by CSS rather than display:none for the same reason.

                Two consequences of that choice are handled here. It is taken out of the
                tab order and hidden from assistive tech, so nobody navigating by keyboard
                or screen reader can land in it by accident. And the label says what to do
                with it, so that if the stylesheet ever fails to load the field degrades
                into a visible input that tells the truth rather than a mystery box.

                Never rendered with a value. A password manager that fills this in once
                would otherwise lock that person out of the form permanently.
            *@
            <div class="offscreen" aria-hidden="true">
                <label for="@FormGuard.HoneypotField">Leave this field empty</label>
                <input type="text" id="@FormGuard.HoneypotField" name="@FormGuard.HoneypotField"
                       value="" autocomplete="off" tabindex="-1" />
            </div>
            <input type="hidden" name="@FormGuard.TimestampField" value="@Model.IssuedTimestamp" />

            <div class="field">
                <label asp-for="Input.GroupName">
                    SMS group name
                    <span class="label-optional">optional</span>
                </label>
                <input asp-for="Input.GroupName" placeholder="soccer team 2023" autocomplete="off" />
                <p class="hint">This helps you tell multiple teams and rosters apart. Skip it if you like.</p>
                <span asp-validation-for="Input.GroupName" class="validation-message"></span>
            </div>

            @*
                Roster import: one box, two ways to fill it.

                The photo control and the textarea are alternatives — both put text in the
                same place — so they sit behind a tab apiece rather than stacked, which
                read as two steps to do in sequence.

                The tablist ships hidden and photo-ocr.js reveals it, for the reason the
                photo control itself used to ship hidden: none of the photo path works
                without JavaScript, and a tab that switches to a dead control is worse
                than no tab. With script off this field is the label, the textarea and the
                hint — exactly what it was before the tabs existed — which is why the
                textarea panel is first in source order and the photo panel is the one
                carrying `hidden`.
            *@
            <div class="field field-tight">
                <label asp-for="Input.RawText">Roster import</label>

                @* type="button" on both: inside a form, a bare <button> submits it. *@
                <div class="tabs" data-import-tabs role="tablist" aria-label="How to get the roster in" hidden>
                    <button type="button" class="tab" role="tab" id="tab-paste"
                            aria-selected="true" aria-controls="panel-paste"
                            data-import-tab="paste">Paste text</button>
                    @* Two labels, one tab. There is no room for the long one beside
                       "Paste text" on a 390px screen, and CSS is what chooses — the same
                       trick .photo-title plays for fine and coarse pointers. *@
                    <button type="button" class="tab" role="tab" id="tab-photo"
                            aria-selected="false" aria-controls="panel-photo" tabindex="-1"
                            data-import-tab="photo"><span class="tab-long">Photo of the roster</span><span class="tab-short">Photo</span></button>
                </div>

                <div class="tab-panel" id="panel-paste" role="tabpanel" aria-labelledby="tab-paste" tabindex="0">
                    <textarea asp-for="Input.RawText" rows="6"
                              placeholder="Paste anything here — names, numbers, whatever your phone copied."></textarea>
                    <p class="hint">
                        Paste whatever your phone will &quot;copy as text&quot;. Import pulls the phone
                        numbers out of the garbled result, in whatever format they are written.
                    </p>
                    <span asp-validation-for="Input.RawText" class="validation-message"></span>
                </div>

                <div class="tab-panel" id="panel-photo" role="tabpanel" aria-labelledby="tab-photo" tabindex="0"
                     data-photo hidden>

                    @* The zone is labelled by its tab now — the tab is what names this
                       control, so a separate field label would say the same thing twice. *@
                    <div class="photo" data-photo-zone role="group" aria-labelledby="tab-photo">
                        <div class="photo-idle" data-photo-idle>
                            <span class="photo-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14.5 4h-5L8 6H4.5A1.5 1.5 0 0 0 3 7.5v11A1.5 1.5 0 0 0 4.5 20h15a1.5 1.5 0 0 0 1.5-1.5v-11A1.5 1.5 0 0 0 19.5 6H16z" />
                                    <circle cx="12" cy="13" r="3.5" />
                                </svg>
                            </span>

                            @* The paste hint starts hidden for the same reason the whole
                               control does: photo-ocr.js reveals it only once the paste
                               listener is actually wired up, so it never promises a shortcut
                               that does nothing. It rides inside .on-fine because pasting is a
                               keyboard move — there is nothing to press on a phone. *@
                            <p class="photo-title">
                                <span class="on-fine">
                                    Drop a photo of the roster here<span data-photo-paste-hint hidden>, or paste one</span>
                                </span>
                                <span class="on-coarse">Snap the roster and it reads itself</span>
                            </p>
                            <p class="photo-or">or</p>

                            <div class="photo-actions">
                                <button type="button" class="button button-secondary photo-camera" data-photo-take>
                                    Take a photo
                                </button>
                                <button type="button" class="button button-secondary" data-photo-choose>
                                    Choose a photo
                                </button>

                                @* The only way to paste on a phone, and it ships hidden for
                                   the same reason everything else here does: photo-ocr.js
                                   reveals it once it has confirmed the browser can actually
                                   read the clipboard.

                                   The paste *hint* above is a different feature that only
                                   looks like this one. It advertises the paste event, which
                                   needs a focused editable element to fire into — there is
                                   none in this panel, so on a phone that event never comes.
                                   This button asks the clipboard for the image instead. *@
                                <button type="button" class="button button-secondary" data-photo-paste hidden>
                                    Paste a photo
                                </button>
                            </div>

                            <p class="photo-note">
                                Read on your device — the photo is never uploaded anywhere.
                            </p>
                        </div>

                        <div class="photo-busy" data-photo-busy hidden>
                            <img class="photo-preview" data-photo-preview alt="" />
                            <div class="photo-progress">
                                <div class="photo-bar"><span data-photo-bar></span></div>
                                <p class="photo-status" data-photo-status role="status" aria-live="polite"></p>
                                <button type="button" class="photo-reset" data-photo-reset hidden>Use a different photo</button>
                            </div>
                        </div>
                    </div>

                    @*
                        The paste fallback, and on an iPhone the only paste that works.

                        Reading the clipboard is a request the browser may decline, and
                        Safari declines it in the least useful way available: it hands back
                        an item and then describes it as holding nothing at all. Pasting
                        *into* something is the older route and the one iOS has always
                        supported — but a paste needs an editable element to land in, and
                        this panel had none. This is that element and nothing else.

                        Revealed only once the Paste a photo button has already failed, so
                        the ordinary path stays one tap and this never shows up for anyone
                        it would only puzzle.
                    *@
                    <div class="photo-paste" data-photo-paste-fallback hidden>
                        <p class="hint">
                            Your browser would not hand the clipboard over. Tap the box below,
                            then choose <strong>Paste</strong>.
                        </p>
                        <div class="photo-paste-target" data-photo-paste-target
                             contenteditable="true" role="textbox"
                             aria-label="Paste the photo here"></div>
                    </div>

                    @* Says where the text lands, because the tab that reads it is not the
                       tab it lands on. *@
                    <p class="hint">
                        Whatever it reads goes into the Paste text box, where you can fix it
                        before importing.
                    </p>

                    @* Two inputs, not one. `capture` asks a phone for the camera directly, which
                       is the point on mobile but takes the photo library away — so the plain
                       input stays for choosing an existing shot. *@
                    <input type="file" accept="image/*" hidden data-photo-file aria-hidden="true" tabindex="-1" />
                    <input type="file" accept="image/*" capture="environment" hidden data-photo-capture aria-hidden="true" tabindex="-1" />
                </div>

                @*
                    Diagnostics for the photo path, revealed only by /new?debug=1.

                    This is the one part of the app that cannot be tested from here. It is a
                    camera, an image decoder and a WebAssembly engine, and the three of them
                    disagree from browser to browser — so when it misreads a roster on
                    somebody's phone, the only way to find out why has been to guess, and
                    every guess costs a round trip. This writes down what happened instead.

                    Deliberately not a console log: the phone where this goes wrong is the
                    phone with no console attached to it.

                    Nothing here is sent anywhere. The photo never leaves the device — that
                    is the whole reason the OCR runs locally — and neither does this, until
                    somebody reads it and chooses to copy it.

                    It sits outside the tab panels so that switching tabs does not take it
                    away, and it is a readonly textarea rather than a <pre> because a phone
                    can select the whole of one in a single tap.
                *@
                <div class="photo-debug" data-photo-debug hidden>
                    <p class="hint">
                        <strong>Diagnostics.</strong> This is what the reader saw. It stays on
                        this device unless you copy it.
                    </p>
                    <textarea class="photo-debug-log" data-photo-debug-log rows="12" readonly
                              aria-label="Photo import diagnostics"></textarea>
                    <button type="button" class="button button-secondary" data-photo-debug-copy>
                        Copy diagnostics
                    </button>
                </div>
            </div>

            @*
                The import result sits on the same row as the button that produces it,
                rather than in a block notice below. The message is the server's own count
                — the mock shows a longer sentence naming what was collapsed and dropped,
                but NewModel has no such figures and inventing them would be a lie about
                the parse.
            *@
            <div class="actions actions-import">
                @* Route values named explicitly rather than left to the ambient ones, so
                   the formaction stays correct on /new/{id} as well as on /new.

                   formnovalidate, and it is load-bearing. The generate gate's checkbox is
                   `required`, and a required field blocks *every* submit button in the
                   form — so without this, Import silently does nothing until the gate is
                   ticked, and photo-ocr.js's importButton.click() is swallowed the same
                   way: the read text lands in the box and the numbers never appear.

                   Right on its own terms as well as necessary. Import parses text into the
                   numbers box and saves nothing; the gate is a claim about the finished
                   list, which is not a thing anyone can honestly make before they have
                   seen what the import found. Only Generate has to wait for it. *@
                <button type="submit" asp-page="/New" asp-page-handler="Import" asp-route-id="@Model.Id"
                        formnovalidate data-photo-import class="button button-outline">Import</button>

                @if (Model.ImportMessage is not null)
                {
                    <p class="import-note">@Model.ImportMessage</p>
                }
            </div>

            <div class="field">
                <label asp-for="Input.Numbers">Phone numbers</label>
                @* Mono, so the numbers line up in a column and a wrong one is easy to
                   spot. The roster import box above stays in the UI font — prose, not data. *@
                <textarea asp-for="Input.Numbers" rows="10" class="numbers" placeholder="(219) 555-0113"></textarea>
                <p class="hint">
                    One per line. Edit freely — anything you type is re-checked when you generate.
                </p>
                <span asp-validation-for="Input.Numbers" class="validation-message"></span>
            </div>

            @*
                The gate. "Remove your own number" used to be a bold line in the hint above,
                which is the one warning on this page that is worth more than prose: leave
                yourself in and iPhones split the group into two threads, so half the roster
                sees half the replies and nobody can tell why.

                So it stops being advice and becomes a step. The claim and the button share
                a box that is tinted red until the box is ticked, and the checkbox is
                `required` rather than the button being `disabled` — a disabled button is a
                dead end that says nothing, where required makes the browser point at the
                thing that needs doing, and keeps working with JavaScript off. The disabled
                *look* is CSS, from :has(:checked) on the panel.

                Never rendered back as ticked on a fresh form: OnGetAsync leaves it false on
                /new/{id}, so editing a saved roster asks again before regenerating. The
                list can have changed since it was last confirmed.
            *@
            <div class="gate">
                <label class="gate-check">
                    <input asp-for="Input.OwnNumberExcluded" required />
                    <span>
                        <span class="gate-title">My own number is not in this list</span>
                        <span class="gate-why">
                            If it is, iPhones split the group into two threads and everyone
                            gets half the replies.
                        </span>
                    </span>
                </label>

                <div class="actions gate-actions">
                    <button type="submit" class="button">@(Model.HasResult ? "Regenerate" : "Generate")</button>
                    <span class="gate-nudge">Tick the box to continue.</span>
                </div>

                <span asp-validation-for="Input.OwnNumberExcluded" class="validation-message"></span>
            </div>
        </form>
    </section>

    <section class="panel">
        @if (Model.HasResult)
        {
            @*
                One source order, reordered by CSS. Source order is coarse-first on purpose:
                if the stylesheet never arrives, a phone still gets the tap it came for at
                the top, which is the failure that matters. On a fine pointer the QR moves
                back above the tap with `order`.

                On a phone the QR is the one thing here you cannot use — you cannot scan
                your own screen — so it folds into a <details> and the action that does work
                leads. On a desktop it is the other way round.
            *@
            var plural = Model.Numbers.Count == 1 ? "" : "s";
            var named = !string.IsNullOrWhiteSpace(Model.Input.GroupName);

            <div class="result" id="@NewModel.ResultAnchor">
                <div class="result-head">
                    <h1>@(named ? $"{Model.Input.GroupName} is ready" : "Your list is ready")</h1>
                    <p class="result-count">@Model.Numbers.Count number@(plural)</p>
                </div>

                <div class="result-open">
                    @* Fine pointer only: the card above is the subject, this labels it. *@
                    <p class="result-open-lead">Point your phone's camera at this</p>

                    @if (Model.QrTooLarge)
                    {
                        @*
                            Moved out of the card deliberately. With no QR to show there is
                            no reveal to put this behind, and on a phone the tap below is
                            then the only route left — so the reason it is the only route
                            has to be visible rather than folded away.
                        *@
                        <p class="notice">
                            This list is too long to fit in a QR code — @Model.Numbers.Count numbers.
                            Opening Messages still works.
                        </p>
                    }

                    @*
                        The anchor is last in source and hoisted by `order` on a coarse
                        pointer. That is what lets one element be a full-width button on a
                        phone and the inline link at the end of the sentence on a desktop,
                        without a second copy of the href to drift out of step.
                    *@
                    <p class="result-open-note">
                        <span class="result-open-fine">
                            Messages opens with all @Model.Numbers.Count number@(plural) in it.
                            Already on your phone?
                        </span>
                        <span class="result-open-coarse">
                            Opens a new message with all @Model.Numbers.Count number@(plural) already
                            in the To: field. Nothing sends until you hit send.
                        </span>
                        <a class="button-open" href="@Model.SmsUrl">
                            <svg class="button-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.6 9.6 0 0 1-2.8-.4L4 21l1.6-4.2A8.2 8.2 0 0 1 3.6 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z"></path>
                            </svg>
                            <span class="button-open-coarse">Open Messages</span>
                            <span class="button-open-fine">Use the mobile link</span>
                        </a>
                    </p>
                </div>

                @if (!Model.QrTooLarge)
                {
                    @*
                        Deliberately no `open` attribute. Adding one would leave the reveal
                        open on a phone, which is the whole thing this change undoes. The
                        fine pointer forces it open from CSS instead, and print does the
                        same — and with no CSS at all it is still a <details> anyone can
                        expand, so the code is never unreachable.
                    *@
                    <details class="qr-reveal">
                        <summary>
                            <svg class="qr-reveal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
                                <rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
                                <path d="M14 17.5h3.5M17.5 14v7M21 14v.01M21 21v.01"></path>
                            </svg>
                            <span class="qr-reveal-label">Show the QR code</span>
                            <span class="qr-reveal-note">for another phone</span>
                        </summary>

                        <div class="qr-reveal-body">
                            @*
                                The tear-off card, unchanged inside. On a coarse pointer it
                                sheds its own chrome — the reveal already provides a box —
                                and its head is hidden, because the name is the page
                                heading two elements up.
                            *@
                            <div class="qr-card">
                                <div class="qr-card-head">
                                    @if (named)
                                    {
                                        <span class="qr-card-name">@Model.Input.GroupName</span>
                                    }
                                    <span class="qr-card-count">
                                        @Model.Numbers.Count number@(plural)
                                    </span>
                                </div>

                                @if (Model.QrDataUri is not null)
                                {
                                    <img class="qr" src="@Model.QrDataUri" alt="QR code that opens a group message to this roster"
                                         width="640" height="640" />
                                }
                            </div>

                            <p class="hint qr-reveal-hint">
                                Hold this up to someone else's camera and their phone opens the same message.
                            </p>
                        </div>
                    </details>
                }

                @*
                    A different job from the two above — keep the URL, come back and edit
                    the list — so it sits below a rule rather than in a row of send actions.
                *@
                <div class="result-keep" data-result-keep>
                    <p class="hint">Coming back to change this list later?</p>
                    <button type="button" class="button button-secondary" data-copy="@Model.ShareUrl">
                        Save the link to this list
                    </button>
                    <span class="result-keep-status" data-copy-status role="status"></span>
                </div>

                <details class="roster">
                    <summary>@Model.Numbers.Count number@(plural) in this list</summary>
                    <ol>
                        @foreach (var number in Model.Numbers)
                        {
                            <li>@PhoneNumberParser.Format(number)</li>
                        }
                    </ol>
                </details>
            </div>
        }
        else
        {
            <div class="placeholder">
                <p>Your QR code shows up here once you generate the list.</p>
            </div>
        }
    </section>
</div>

@section Scripts {
    @* Only on this page. The home page has no photo control and should not pay for the
       script that drives one; the OCR engine itself is fetched later still, on first use. *@
    <script src="~/js/photo-ocr.js" asp-append-version="true"></script>
}
