{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Fallback for running this project on its own (`dotnet run` in this directory)
    // against a locally installed Azurite. Under the Aspire AppHost this is overridden by
    // ConnectionStrings__tables in the environment, which points at the emulator
    // container Aspire starts — so both ways of running work without editing anything.
    "tables": "UseDevelopmentStorage=true"
  }
}
