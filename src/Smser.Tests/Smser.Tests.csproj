<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.3.3" />
    <!-- Boots Smser.Web in-process for the page-wiring tests. The form/handler bugs those
         catch live in Razor markup, where no unit test can see them. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <!-- Runs the photo import's rotation maths for real. The wiring tests can only check
         that the code is present, which is exactly how a clamp that made the orientation
         search pick the wrong answer passed CI and shipped. Jint is pure managed, so it
         needs no browser and runs on the Linux agent like everything else. -->
    <PackageReference Include="Jint" Version="4.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Smser.Library\Smser.Library.csproj" />
    <!-- For QrCodeGenerator. It lives in the web app rather than the Library because
         rendering is a presentation concern, but its too-large-to-encode fallback is the
         thing standing between a 250-person roster and a 500, so it gets tested. -->
    <ProjectReference Include="..\Smser.Web\Smser.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="Smser.Library" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sample rosters live at the repo root, not in here, because they are also
         meant to be opened and pasted into the running app by hand. Linking them into
         the test output is what stops them drifting away from what the parser does. -->
    <Content Include="..\..\samples\*.txt" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\samples\*.expected" Link="Samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
